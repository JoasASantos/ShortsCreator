# ShortsCreator — template. Copy to .env and fill in what you need.
#
#   cp .env.example .env      (or just: make setup)
#
# Every variable the backend reads is here, each with what it does and whether
# it is REQUIRED or OPTIONAL. Placeholders are obvious on purpose — nothing in
# this file is a real credential, and .env is gitignored so yours stays local.
# `make doctor` tells you which of these you are actually missing.

# ============ LLM ============
# claude_cli / codex_cli use the subscription already logged in on this machine
# (Claude Pro/Max via `claude`, ChatGPT Plus/Pro via `codex login`). No API key.

# REQUIRED — which model path writes the scripts.
# chain | claude_cli | codex_cli | anthropic | openai | ollama
LLM_PROVIDER=chain

# OPTIONAL (read only when LLM_PROVIDER=chain) — models tried in order, falling
# through to the next one on failure. Format: provider:model,provider:model
LLM_CHAIN=claude_cli:claude-fable-5-1,claude_cli:claude-opus-5,codex_cli:gpt-5.6-sol

# --- via CLI (no key, uses the subscription) ---
# OPTIONAL — name or full path of the Claude Code binary.
CLAUDE_CLI_BIN=claude
# OPTIONAL — empty means whatever model your `claude` session defaults to.
CLAUDE_CLI_MODEL=
# OPTIONAL — name or full path of the Codex binary.
CODEX_CLI_BIN=codex
# OPTIONAL — empty means the Codex default.
CODEX_CLI_MODEL=gpt-5.6-sol
# OPTIONAL — how hard Codex thinks: low | medium | high | xhigh
CODEX_REASONING_EFFORT=medium
# OPTIONAL — seconds before a CLI call is considered lost.
LLM_CLI_TIMEOUT=420

# --- via API key (billed per token) ---
# OPTIONAL — needed only for LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# OPTIONAL — Anthropic model id used with the key above.
ANTHROPIC_MODEL=claude-opus-5
# OPTIONAL — needed only for LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-REPLACE_ME
# OPTIONAL — OpenAI model id used with the key above.
OPENAI_MODEL=gpt-4o
# OPTIONAL — where a local Ollama answers (LLM_PROVIDER=ollama).
OLLAMA_HOST=http://localhost:11434
# OPTIONAL — Ollama model to pull/run.
OLLAMA_MODEL=llama3.1

# ============ TTS ============
# REQUIRED — which voice engine narrates: edge | elevenlabs | xtts | fishaudio
# edge is the default and free, and gives the most accurate karaoke timing.
TTS_PROVIDER=edge
# OPTIONAL — edge-tts voice id. Change it and the narration language changes.
EDGE_VOICE=pt-BR-AntonioNeural
# OPTIONAL — ElevenLabs voice cloning (also settable on the Accounts screen).
ELEVENLABS_API_KEY=REPLACE_ME
# OPTIONAL — ElevenLabs model id.
ELEVENLABS_MODEL=eleven_multilingual_v2
# OPTIONAL — local XTTS (coqui) server, cloning from a 6-30s sample.
XTTS_SERVER=http://localhost:8020
# OPTIONAL — fish.audio voice catalog (also settable on the Accounts screen).
FISHAUDIO_API_KEY=REPLACE_ME
# OPTIONAL — s2.1-pro-free and s2-pro work with no credit; s1 and s2.1-pro bill.
FISHAUDIO_BACKEND=s2.1-pro-free
# OPTIONAL — pin one fish.audio voice model id; empty means pick per job.
FISHAUDIO_MODEL=

# ============ B-ROLL ============
# All OPTIONAL — with none of them, the background falls back to the animated
# gradient or to media the job brings itself.
PEXELS_API_KEY=REPLACE_ME
PIXABAY_API_KEY=REPLACE_ME
COVERR_API_KEY=REPLACE_ME
# OPTIONAL — stock clips are tens of MB each and a short uses several, so they
# are deleted after the render. true keeps them, which pays off only while
# iterating on the same short.
BROLL_KEEP_CACHE=

# ============ VIDEO / AVATAR GENERATORS ============
# All OPTIONAL. Every connector below can also be registered from the Accounts
# screen, which is stored in the database and wins over the value here — .env
# is only the fallback.

# Higgsfield: generates the background with AI (background='ia_video').
HIGGSFIELD_KEY_ID=REPLACE_ME
HIGGSFIELD_KEY_SECRET=REPLACE_ME
# HeyGen: talking presenter built from the script.
HEYGEN_API_KEY=REPLACE_ME
# Google Gemini / Nano Banana image generation.
GEMINI_API_KEY=REPLACE_ME
# Planned connectors — the key can be stored now, the call lands later.
RUNWAY_API_KEY=REPLACE_ME
DID_API_KEY=REPLACE_ME

# OPTIONAL — empty means generators/registry.py picks the backend, and the
# reason lands in the job log. Naming one forces it.
VIDEOGEN_PROVIDER=
VIDEOGEN_MODEL=
# OPTIONAL — local ComfyUI, free but needs the server running.
COMFYUI_URL=http://127.0.0.1:8188
# OPTIONAL — the workflow JSON ComfyUI is driven with.
COMFYUI_WORKFLOW=./data/comfyui/workflow.json
# OPTIONAL — local Automatic1111 WebUI with --api enabled.
A1111_URL=http://127.0.0.1:7860
# OPTIONAL — true puts the free local servers ahead of the paid APIs whenever
# both could do the job.
GENERATOR_PREFER_LOCAL=

# ============ PUBLISH ============
# All OPTIONAL — without them the short is still rendered, just not uploaded.

# YouTube: path to the OAuth client_secret JSON you downloaded from Google.
YOUTUBE_CLIENT_SECRETS=./data/secrets/youtube_client_secret.json
# TikTok: app credentials from developers.tiktok.com.
TIKTOK_CLIENT_KEY=REPLACE_ME
TIKTOK_CLIENT_SECRET=REPLACE_ME
# TikTok: must match the redirect URI registered on the app, byte for byte.
TIKTOK_REDIRECT_URI=http://localhost:8000/api/publish/tiktok/callback
# Instagram Reels: long-lived token for a professional account linked to a
# Facebook page. The Graph API DOWNLOADS the MP4, so PUBLIC_API_URL below has
# to be reachable from the internet.
INSTAGRAM_ACCESS_TOKEN=REPLACE_ME
INSTAGRAM_USER_ID=REPLACE_ME
# LinkedIn: token with w_member_social. An empty URN is discovered from the
# token (which then also needs openid and profile in the scope).
LINKEDIN_ACCESS_TOKEN=REPLACE_ME
LINKEDIN_AUTHOR_URN=

# ============ NOTIFICATIONS ============
# All OPTIONAL — fired when a short finishes, fails or gets published. With
# nothing filled in, nothing is sent and nothing complains.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME
# Generic webhook: receives POST JSON {title, body, url, level}.
NOTIFY_WEBHOOK_URL=https://example.invalid/REPLACE_ME

# ============ APP ============
# OPTIONAL — public address of the API. localhost is fine for everything EXCEPT
# Instagram Reels, where Meta downloads the MP4 from this URL. Behind a tunnel:
# PUBLIC_API_URL=https://xxx.ngrok.app
PUBLIC_API_URL=http://localhost:8000
# OPTIONAL — where the interface answers. Used in notification links, so a
# Telegram message stays clickable from your phone when you run behind a tunnel.
PUBLIC_WEB_URL=http://localhost:3000
# OPTIONAL — where jobs, cache, outputs, uploads and the SQLite file live.
DATA_DIR=./data
# OPTIONAL — faster-whisper model used when a video needs transcribing:
# tiny | base | small | medium | large-v3. Bigger is more accurate and slower.
WHISPER_MODEL=base
# OPTIONAL — the model used to caption YOUR OWN recording, held to a higher
# standard than locating a moment: those words get burned into the frame, so a
# misheard one is worse than no caption. Lower it if the machine is slow.
REELS_WHISPER_MODEL=small
# OPTIONAL — the QA audit rejects a short outside this window, and the
# self-adjust loop stretches or trims the script to fit it.
MAX_SHORT_SECONDS=90
MIN_SHORT_SECONDS=15
# OPTIONAL — rejects an upload above this size before it reaches the disk.
MAX_UPLOAD_MB=300
# OPTIONAL — how much of a GitHub repository goes into the script prompt.
# Raising these costs LLM tokens on every repo job.
GITHUB_MAX_FILES=12
GITHUB_MAX_FILE_CHARS=6000
