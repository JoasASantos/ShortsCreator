# ============ LLM ============
# claude_cli / codex_cli usam a assinatura já logada na máquina (Claude Pro/Max
# via `claude`, ChatGPT Plus/Pro via `codex login`). Não exigem chave de API.
LLM_PROVIDER=chain                # chain | claude_cli | codex_cli | anthropic | openai | ollama

# chain = tenta os modelos em ordem e cai pro próximo se um falhar.
# Formato: provider:modelo,provider:modelo (o modelo é opcional).
LLM_CHAIN=claude_cli:claude-fable-5-1,claude_cli:claude-opus-5,codex_cli:gpt-5.6-sol

# --- via CLI (sem chave, usa assinatura) ---
CLAUDE_CLI_BIN=claude
CLAUDE_CLI_MODEL=                 # vazio = modelo padrão da sua sessão
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium     # low | medium | high | xhigh
LLM_CLI_TIMEOUT=420               # segundos por chamada

# --- via chave de API (cobrado por token) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ============ TTS ============
TTS_PROVIDER=edge                 # edge | elevenlabs | xtts | fishaudio
# edge-tts: gratuito, vozes neurais pt-BR (sem clonagem)
EDGE_VOICE=pt-BR-AntonioNeural
# elevenlabs: clonagem de voz (Seu Madruga etc.)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# xtts local (coqui) - clonagem por sample de 6-30s
XTTS_SERVER=http://localhost:8020
FISHAUDIO_API_KEY=
# s2.1-pro-free e s2-pro funcionam sem crédito de API; s1 e s2.1-pro exigem saldo
FISHAUDIO_BACKEND=s2.1-pro-free
FISHAUDIO_MODEL=

# ============ B-ROLL ============
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ============ GERADORES DE VÍDEO / AVATAR ============
# Todos os conectores abaixo também podem ser cadastrados pela tela Contas
# (fica salvo no banco e vence o valor daqui). .env é só o fallback.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HEYGEN_API_KEY=
# previstos, sem chamada de API implementada ainda:
RUNWAY_API_KEY=
DID_API_KEY=

# ============ PUBLISH ============
YOUTUBE_CLIENT_SECRETS=./data/secrets/youtube_client_secret.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/publish/tiktok/callback
# Instagram Reels: conta profissional ligada a uma página do Facebook.
# A Graph API BAIXA o vídeo, então PUBLIC_API_URL precisa ser público.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# LinkedIn: token com w_member_social. URN vazio = descobre pelo token
# (exige também openid e profile no escopo).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# ============ AVISOS (opcional) ============
# Quando um short termina, falha ou é publicado. Sem nada preenchido, silêncio.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

# ============ APP ============
API_HOST=0.0.0.0
API_PORT=8000
# Endereço público da API. localhost serve para tudo, MENOS Instagram Reels —
# a Meta baixa o MP4 por essa URL. Com túnel: PUBLIC_API_URL=https://xxx.ngrok.app
PUBLIC_API_URL=http://localhost:8000
DATA_DIR=./data
WHISPER_MODEL=base                # usado só se precisar transcrever vídeo sem legenda
MAX_SHORT_SECONDS=90
MIN_SHORT_SECONDS=15
