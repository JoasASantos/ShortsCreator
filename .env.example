# ============ LLM ============
# claude_cli / codex_cli use the subscription already logged in on this machine
# (Claude Pro/Max via `claude`, ChatGPT Plus/Pro via `codex login`). No API key.
LLM_PROVIDER=chain                # chain | claude_cli | codex_cli | anthropic | openai | ollama

# chain = try the models in order and fall through to the next one on failure.
# Format: provider:model,provider:model (the model is optional).
LLM_CHAIN=claude_cli:claude-fable-5-1,claude_cli:claude-opus-5,codex_cli:gpt-5.6-sol

# --- via CLI (no key, uses the subscription) ---
CLAUDE_CLI_BIN=claude
CLAUDE_CLI_MODEL=                 # empty = the default model of your session
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium     # low | medium | high | xhigh
LLM_CLI_TIMEOUT=420               # seconds per call

# --- via API key (billed per token) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ============ TTS ============
TTS_PROVIDER=edge                 # edge | elevenlabs | xtts | fishaudio
# edge-tts: free, neural pt-BR voices (no cloning)
EDGE_VOICE=pt-BR-AntonioNeural
# elevenlabs: voice cloning (Seu Madruga and friends)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# xtts local (coqui) - cloning from a 6-30s sample
XTTS_SERVER=http://localhost:8020
FISHAUDIO_API_KEY=
# s2.1-pro-free and s2-pro work without API credit; s1 and s2.1-pro need balance
FISHAUDIO_BACKEND=s2.1-pro-free
FISHAUDIO_MODEL=

# ============ B-ROLL ============
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ============ VIDEO / AVATAR GENERATORS ============
# Every connector below can also be registered from the Accounts screen
# (it is stored in the database and overrides the value here). .env is only
# the fallback.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HEYGEN_API_KEY=
# planned, no API call implemented yet:
RUNWAY_API_KEY=
DID_API_KEY=

# ============ PUBLISH ============
YOUTUBE_CLIENT_SECRETS=./data/secrets/youtube_client_secret.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/publish/tiktok/callback
# Instagram Reels: a professional account linked to a Facebook page.
# The Graph API DOWNLOADS the video, so PUBLIC_API_URL has to be public.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# LinkedIn: a token with w_member_social. An empty URN = discover it from the
# token (which also requires openid and profile in the scope).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# ============ NOTIFICATIONS (optional) ============
# Fired when a short finishes, fails or gets published. Nothing filled in, silence.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

# ============ APP ============
API_HOST=0.0.0.0
API_PORT=8000
# Public address of the API. localhost is fine for everything EXCEPT Instagram
# Reels — Meta downloads the MP4 from this URL. With a tunnel:
# PUBLIC_API_URL=https://xxx.ngrok.app
PUBLIC_API_URL=http://localhost:8000
# Where the interface answers. Used in notification links, so a Telegram
# message stays clickable from your phone when you run behind a tunnel.
PUBLIC_WEB_URL=http://localhost:3000
DATA_DIR=./data
WHISPER_MODEL=base                # used only when a video needs transcribing
MAX_SHORT_SECONDS=90
MIN_SHORT_SECONDS=15
